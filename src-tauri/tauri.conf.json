{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAFE",
  "version": "0.1.0",
  "identifier": "mx.nafe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "NAFE — Confianza en lo que nace cerca",
        "width": 412,
        "height": 892,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    }
  }
}
